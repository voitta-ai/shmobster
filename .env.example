# --- Slack (Socket Mode) ---
# Either create a new app from deploy/slack-app-manifest.yaml, OR paste the
# existing @Shmobster bot's tokens. The code is identical either way.
#   Bot token  (xoxb-...): OAuth & Permissions
#   App token  (xapp-...): Basic Information -> App-Level Tokens, scope connections:write
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# Channels Shmobster listens in (comma-separated IDs). Iter 0: just m-and-a.
SHMOBSTER_CHANNELS=C0ACJGUGB0A

# Marker prefixed to every post (robots.txt-for-agents convention).
SHMOBSTER_AGENT_LABEL=shmobster

# Workspace home (the .md spine: SOUL/USER/CALIBRATION/RUNBOOKS/TOOLS/memory).
# Point at your openclaw-workspace clone, or use the bundled ./workspace.
SHMOBSTER_WORKSPACE=./workspace

# --- Waterfall ---
# Ordered vendor list (LiteLLM model ids). First is primary; rest are fallbacks
# in order. A vendor that errors is skipped for a cooldown window.
SHMOBSTER_MODELS=anthropic/claude-sonnet-5,openai/gpt-5,gemini/gemini-2.5-pro

# Keys read by LiteLLM via each vendor's standard env var.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
