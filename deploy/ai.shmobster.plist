<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd supervisor for Shmobster. Install:
    cp deploy/ai.shmobster.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/ai.shmobster.plist
  Stop:
    launchctl bootout gui/$(id -u)/ai.shmobster.agent

  ThrottleInterval=10 is the anti-crash-loop guard (the OpenClaw gateway
  respawned every ~1.7s and bloated its log to 1.8GB with no throttle).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.shmobster.agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/gregory.golberg/g/git.voitta/shmobster/.venv/bin/python</string>
    <string>-m</string>
    <string>shmobster.slack_app</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/gregory.golberg/g/git.voitta/shmobster</string>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/Users/gregory.golberg/g/git.voitta/shmobster/logs/shmobster.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/gregory.golberg/g/git.voitta/shmobster/logs/shmobster.err.log</string>
</dict>
</plist>
