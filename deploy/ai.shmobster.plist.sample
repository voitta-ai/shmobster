<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  SAMPLE launchd plist. Copy to deploy/ai.shmobster.plist (gitignored) and
  replace every /Users/CHANGE_ME/path/to/shmobster with the absolute path to
  your checkout. Then: deploy/service.sh install

  ThrottleInterval=10 is the anti-crash-loop guard (the OpenClaw gateway
  respawned every ~1.7s with no throttle and bloated its log to 1.8GB).

  PATH is set explicitly (#50): launchd hands a process
  /usr/bin:/bin:/usr/sbin:/sbin and nothing else, so without this the agent
  cannot see gh, git-lfs, aws, node, or anything else from Homebrew -- every
  such command dies with exit 127 "command not found", which reads like a
  permission gate but isn't. Adjust for Intel Macs (/usr/local/bin) or add
  version-manager shims as needed.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.shmobster.agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/CHANGE_ME/path/to/shmobster/.venv/bin/python</string>
    <string>-m</string>
    <string>shmobster.slack_app</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/CHANGE_ME/path/to/shmobster</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/Users/CHANGE_ME/path/to/shmobster/logs/shmobster.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/CHANGE_ME/path/to/shmobster/logs/shmobster.err.log</string>
</dict>
</plist>
