{
  "channel_policies": {
    "C0FREEFORALL": {
      "cwd": "/path/to/home"
    },
    "C0SCOPEDCHANNEL": {
      "cwd": "/path/to/project",
      "github_repos": [
        "your-org/your-repo"
      ],
      "aws_profile": "your-aws-profile",
      "exclude": [
        "~/g/OneDrive"
      ],
      "allow_read": [
        "~/g/project-data"
      ],
      "allow_write": [],
      "env": {
        "VERCEL_TOKEN": "${VERCEL_TOKEN}",
        "HEROKU_API_KEY": "${HEROKU_API_KEY}"
      }
    }
  },
  "default_policy": {
    "cwd": "/path/to/home"
  }
}
